          "name": "Query Business Dynamics Statistics Time Series",
          "request": {
            "name": "Query Business Dynamics Statistics Time Series",
            "description": {
              "content": "Query the BDS time series. Use `YEAR` in the `get` clause and add it to\nthe `for` clause or filter with `time`, `STATE`, `MSA`, `NAICS`, `SECTOR`,\n`EAGE`, `FAGE`, `EMPSZES`, `FSIZE`, and other dimension variables.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "timeseries",
                "bds"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "get",
                  "value": "<string>",
                  "description": "(Required) Variables to retrieve (for example `YEAR,FAGE,FIRMS,ESTABS,NET_JOB_CREATION`)."
                },
                {
                  "disabled": false,
                  "key": "for",
                  "value": "<string>",
                  "description": "Geography clause (for example `us:*` or `state:06`)."
                },
                {
                  "disabled": false,
                  "key": "time",
                  "value": "<string>",
                  "description": "Time filter (for example `2022`, `from 2018 to 2022`)."
                },
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) "
                }
              ],
              "variable": []
            },
