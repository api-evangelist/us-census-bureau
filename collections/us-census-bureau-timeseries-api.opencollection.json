                "description": "Time filter (for example `2024-01`, `from 2024-01 to 2024-12`)."
              },
              {
                "name": "I_COMMODITY",
                "value": "",
                "type": "query"
              },
              {
                "name": "key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "U.S. monthly imports broken down by Harmonized System commodity codes."
        },
        {
